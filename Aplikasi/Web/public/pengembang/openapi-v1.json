          "Data"
        ],
        "security": [
          {
            "TokenApi": [
              "produk:baca"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Berhasil",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Produk"
                      }
                    },
                    "Kursor": {
                      "$ref": "#/components/schemas/Kursor"
                    }
                  },
                  "required": [
                    "Data",
                    "Kursor"
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/TokenTidakValid"
          },
          "403": {
            "$ref": "#/components/responses/Ditolak"
          },
          "429": {
            "$ref": "#/components/responses/TerlaluBanyak"
          },
          "422": {
            "$ref": "#/components/responses/ParameterTidakValid"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Per"
          },
          {
            "$ref": "#/components/parameters/Kursor"
          }
        ]
      }
    },
    "/produk/{uuidProduk}": {
      "get": {
        "summary": "Satu produk",
        "tags": [
          "Data"
        ],
        "security": [
          {
            "TokenApi": [
              "produk:baca"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Berhasil",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Data": {
                      "$ref": "#/components/schemas/Produk"
                    }
                  },
                  "required": [
                    "Data"
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/TokenTidakValid"
          },
          "403": {
            "$ref": "#/components/responses/Ditolak"
          },
          "429": {
            "$ref": "#/components/responses/TerlaluBanyak"
