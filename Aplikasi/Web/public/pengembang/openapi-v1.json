  "webhooks": {
    "penjualan.selesai": {
      "post": {
        "summary": "penjualan.selesai",
        "description": "Penjualan diterima server (dari kasir, termasuk yang dibuat offline). Header: X-Id-Peristiwa (dedup), X-Peristiwa, X-Waktu-Kirim (detik Unix), X-Tanda-Tangan: sha256=<HMAC-SHA256 rahasia atas \"{X-Waktu-Kirim}.{badan}\">. Balas 2xx dalam 10 detik; selain itu dicoba ulang 1m, 5m, 30m, 2j, 12j.",
        "tags": [
          "Webhook"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "IdPeristiwa": {
                    "type": "string"
                  },
                  "Peristiwa": {
                    "type": "string",
                    "const": "penjualan.selesai"
                  },
                  "TerjadiPada": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "Data": {
                    "$ref": "#/components/schemas/Penjualan"
                  }
                },
                "required": [
                  "IdPeristiwa",
                  "Peristiwa",
                  "TerjadiPada",
                  "Data"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Diterima penerima"
          }
        }
      }
    },
    "penjualan.divoid": {
      "post": {
        "summary": "penjualan.divoid",
        "description": "Penjualan di-void; Data = penjualan dengan Status Void. Header: X-Id-Peristiwa (dedup), X-Peristiwa, X-Waktu-Kirim (detik Unix), X-Tanda-Tangan: sha256=<HMAC-SHA256 rahasia atas \"{X-Waktu-Kirim}.{badan}\">. Balas 2xx dalam 10 detik; selain itu dicoba ulang 1m, 5m, 30m, 2j, 12j.",
        "tags": [
          "Webhook"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "IdPeristiwa": {
                    "type": "string"
                  },
                  "Peristiwa": {
                    "type": "string",
                    "const": "penjualan.divoid"
                  },
                  "TerjadiPada": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "Data": {
                    "$ref": "#/components/schemas/Penjualan"
                  }
                },
                "required": [
                  "IdPeristiwa",
                  "Peristiwa",
                  "TerjadiPada",
                  "Data"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Diterima penerima"
          }
        }
      }
    },
    "penjualan.diretur": {
      "post": {
        "summary": "penjualan.diretur",
        "description": "Retur penjualan diterima server. Header: X-Id-Peristiwa (dedup), X-Peristiwa, X-Waktu-Kirim (detik Unix), X-Tanda-Tangan: sha256=<HMAC-SHA256 rahasia atas \"{X-Waktu-Kirim}.{badan}\">. Balas 2xx dalam 10 detik; selain itu dicoba ulang 1m, 5m, 30m, 2j, 12j.",
