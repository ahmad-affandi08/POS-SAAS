{
  "openapi": "3.1.0",
  "info": {
    "title": "PAYOU Open API",
    "version": "1.0.0",
    "description": "API baca data usaha untuk aplikasi pihak ketiga (akuntansi, marketplace, BI) dan webhook keluar. Key JSON PascalCase Bahasa Indonesia; uang & jumlah dikirim sebagai string desimal; waktu ISO-8601 UTC; pengenal = Uuid (ULID). Token dibuat Owner di Pengaturan › Token API (paket Bisnis/Enterprise). Batas 120 permintaan/menit per token. Perubahan yang tidak kompatibel = versi baru, versi lama didukung ≥ 6 bulan setelah pengumuman."
  },
  "servers": [
    {
      "url": "https://dashboard.payou.id/api/v1"
    }
  ],
  "tags": [
    {
      "name": "Data",
      "description": "Endpoint baca berkursor"
    },
    {
      "name": "Webhook",
      "description": "Dikirim PAYOU ke alamat HTTPS Anda"
    }
  ],
  "paths": {
    "/produk": {
      "get": {
        "summary": "Daftar produk beserta satuan, barcode & harga dasar",
